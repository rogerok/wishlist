{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["oxc", "typescript", "unicorn", "vitest"],
  "jsPlugins": [
    "eslint-plugin-perfectionist",
    "eslint-plugin-sonarjs",
    "eslint-plugin-turbo"
  ],
  "env": {
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/node_modules/**"],
  "rules": {
    "sonarjs/function-name": "off",
    "sonarjs/class-name": "warn",
    "sonarjs/max-lines": "off",
    "sonarjs/no-tab": "off",
    "sonarjs/variable-name": "off",
    "sonarjs/comment-regex": "off",
    "sonarjs/no-commented-code": "warn",
    "sonarjs/elseif-without-else": "off",
    "sonarjs/no-fallthrough": "warn",
    "sonarjs/nested-control-flow": "off",
    "sonarjs/too-many-break-or-continue-in-loop": "off",
    "sonarjs/max-lines-per-function": "off",
    "sonarjs/no-nested-incdec": "off",
    "sonarjs/no-equals-in-for-termination": "warn",
    "sonarjs/no-extra-arguments": "warn",
    "sonarjs/no-collapsible-if": "off",
    "sonarjs/expression-complexity": "off",
    "sonarjs/no-redundant-parentheses": "off",
    "sonarjs/no-labels": "warn",
    "sonarjs/no-nested-assignment": "warn",
    "sonarjs/no-redundant-boolean": "warn",
    "sonarjs/prefer-single-boolean-return": "warn",
    "sonarjs/unused-import": "warn",
    "sonarjs/fixme-tag": "warn",
    "sonarjs/todo-tag": "off",
    "sonarjs/useless-string-operation": "off",
    "sonarjs/no-unused-function-argument": "off",
    "sonarjs/no-duplicate-string": "off",
    "sonarjs/no-case-label-in-switch": "warn",
    "sonarjs/no-parameter-reassignment": "warn",
    "sonarjs/no-floating-point-equality": "warn",
    "sonarjs/prefer-while": "warn",
    "sonarjs/no-sonar-comments": "off",
    "sonarjs/no-small-switch": "warn",
    "sonarjs/no-hardcoded-ip": "warn",
    "sonarjs/label-position": "warn",
    "sonarjs/public-static-readonly": "warn",
    "sonarjs/file-header": "off",
    "sonarjs/call-argument-line": "warn",
    "sonarjs/max-switch-cases": "warn",
    "sonarjs/no-unused-vars": "off",
    "sonarjs/prefer-immediate-return": "off",
    "sonarjs/function-inside-loop": "warn",
    "sonarjs/code-eval": "warn",
    "sonarjs/no-variable-usage-before-declaration": "off",
    "sonarjs/future-reserved-words": "warn",
    "sonarjs/array-constructor": "off",
    "sonarjs/bitwise-operators": "warn",
    "sonarjs/no-function-declaration-in-block": "off",
    "sonarjs/no-primitive-wrappers": "warn",
    "sonarjs/for-in": "off",
    "sonarjs/cyclomatic-complexity": "off",
    "sonarjs/no-skipped-tests": "warn",
    "sonarjs/no-identical-expressions": "warn",
    "sonarjs/no-nested-switch": "off",
    "sonarjs/constructor-for-side-effects": "warn",
    "sonarjs/no-dead-store": "warn",
    "sonarjs/no-identical-conditions": "warn",
    "sonarjs/no-duplicated-branches": "warn",
    "sonarjs/deprecation": "warn",
    "sonarjs/no-inverted-boolean-check": "warn",
    "sonarjs/misplaced-loop-counter": "warn",
    "sonarjs/no-nested-functions": "warn",
    "sonarjs/no-hardcoded-passwords": "warn",
    "sonarjs/sql-queries": "warn",
    "sonarjs/insecure-cookie": "warn",
    "sonarjs/no-useless-increment": "warn",
    "sonarjs/no-globals-shadowing": "warn",
    "sonarjs/no-undefined-assignment": "off",
    "sonarjs/no-empty-test-file": "off",
    "sonarjs/no-ignored-return": "warn",
    "sonarjs/no-wildcard-import": "off",
    "sonarjs/arguments-order": "warn",
    "sonarjs/pseudo-random": "warn",
    "sonarjs/for-loop-increment-sign": "warn",
    "sonarjs/null-dereference": "warn",
    "sonarjs/no-selector-parameter": "warn",
    "sonarjs/updated-loop-counter": "warn",
    "sonarjs/block-scoped-var": "warn",
    "sonarjs/no-built-in-override": "off",
    "sonarjs/prefer-object-literal": "off",
    "sonarjs/no-ignored-exceptions": "warn",
    "sonarjs/no-gratuitous-expressions": "warn",
    "sonarjs/file-uploads": "warn",
    "sonarjs/file-permissions": "warn",
    "sonarjs/no-empty-character-class": "warn",
    "sonarjs/no-unenclosed-multiline-block": "warn",
    "sonarjs/index-of-compare-to-positive-number": "warn",
    "sonarjs/assertions-in-tests": "warn",
    "sonarjs/no-implicit-global": "warn",
    "sonarjs/no-useless-catch": "warn",
    "sonarjs/xml-parser-xxe": "warn",
    "sonarjs/non-existent-operator": "warn",
    "sonarjs/web-sql-database": "off",
    "sonarjs/post-message": "warn",
    "sonarjs/no-array-delete": "warn",
    "sonarjs/no-alphabetical-sort": "warn",
    "sonarjs/no-fixed-wait-in-tests": "warn",
    "sonarjs/no-incomplete-assertions": "warn",
    "sonarjs/no-global-this": "warn",
    "sonarjs/new-operator-misuse": "warn",
    "sonarjs/no-delete-var": "warn",
    "sonarjs/strings-comparison": "off",
    "sonarjs/file-name-differ-from-class": "off",
    "sonarjs/cookie-no-httponly": "warn",
    "sonarjs/no-nested-conditional": "warn",
    "sonarjs/no-incorrect-string-concat": "off",
    "sonarjs/different-types-comparison": "warn",
    "sonarjs/inverted-assertion-arguments": "warn",
    "sonarjs/shorthand-property-grouping": "off",
    "sonarjs/updated-const-var": "warn",
    "sonarjs/arguments-usage": "off",
    "sonarjs/destructuring-assignment-syntax": "off",
    "sonarjs/no-invariant-returns": "warn",
    "sonarjs/arrow-function-convention": "off",
    "sonarjs/class-prototype": "off",
    "sonarjs/generator-without-yield": "warn",
    "sonarjs/no-require-or-define": "off",
    "sonarjs/no-associative-arrays": "warn",
    "sonarjs/comma-or-logical-or-case": "warn",
    "sonarjs/no-redundant-jump": "warn",
    "sonarjs/inconsistent-function-call": "warn",
    "sonarjs/no-use-of-empty-return-value": "warn",
    "sonarjs/void-use": "warn",
    "sonarjs/operation-returning-nan": "off",
    "sonarjs/values-not-convertible-to-numbers": "off",
    "sonarjs/non-number-in-arithmetic-expression": "off",
    "sonarjs/cognitive-complexity": ["warn", 15],
    "sonarjs/argument-type": "warn",
    "sonarjs/in-operator-type-error": "warn",
    "sonarjs/array-callback-without-return": "warn",
    "sonarjs/declarations-in-global-scope": "off",
    "sonarjs/function-return-type": "warn",
    "sonarjs/no-inconsistent-returns": "off",
    "sonarjs/no-reference-error": "off",
    "sonarjs/no-all-duplicated-branches": "warn",
    "sonarjs/no-same-line-conditional": "warn",
    "sonarjs/conditional-indentation": "off",
    "sonarjs/no-collection-size-mischeck": "warn",
    "sonarjs/no-unthrown-error": "warn",
    "sonarjs/no-unused-collection": "warn",
    "sonarjs/no-os-command-from-path": "warn",
    "sonarjs/no-misleading-array-reverse": "warn",
    "sonarjs/no-for-in-iterable": "off",
    "sonarjs/no-element-overwrite": "warn",
    "sonarjs/no-identical-functions": "warn",
    "sonarjs/no-empty-collection": "warn",
    "sonarjs/no-redundant-assignments": "warn",
    "sonarjs/prefer-type-guard": "warn",
    "sonarjs/use-type-alias": "warn",
    "sonarjs/no-return-type-any": "off",
    "sonarjs/no-implicit-dependencies": "off",
    "sonarjs/no-useless-intersection": "warn",
    "sonarjs/weak-ssl": "warn",
    "sonarjs/no-weak-keys": "warn",
    "sonarjs/csrf": "warn",
    "sonarjs/production-debug": "warn",
    "sonarjs/prefer-default-last": "warn",
    "sonarjs/no-in-misuse": "warn",
    "sonarjs/no-duplicate-in-composite": "warn",
    "sonarjs/max-union-size": "off",
    "sonarjs/no-undefined-argument": "warn",
    "sonarjs/no-nested-template-literals": "warn",
    "sonarjs/prefer-promise-shorthand": "warn",
    "sonarjs/os-command": "off",
    "sonarjs/no-redundant-optional": "warn",
    "sonarjs/hashing": "warn",
    "sonarjs/bool-param-default": "off",
    "sonarjs/no-try-promise": "warn",
    "sonarjs/unverified-certificate": "warn",
    "sonarjs/no-unsafe-unzip": "off",
    "sonarjs/cors": "warn",
    "sonarjs/link-with-target-blank": "warn",
    "sonarjs/disabled-auto-escaping": "warn",
    "sonarjs/table-header": "warn",
    "sonarjs/no-table-as-layout": "warn",
    "sonarjs/table-header-reference": "warn",
    "sonarjs/object-alt-content": "warn",
    "sonarjs/no-clear-text-protocols": "warn",
    "sonarjs/publicly-writable-directories": "warn",
    "sonarjs/unverified-hostname": "warn",
    "sonarjs/encryption-secure-mode": "warn",
    "sonarjs/no-weak-cipher": "warn",
    "sonarjs/no-intrusive-permissions": "off",
    "sonarjs/insecure-jwt-token": "warn",
    "sonarjs/x-powered-by": "warn",
    "sonarjs/hidden-files": "off",
    "sonarjs/content-length": "warn",
    "sonarjs/disabled-resource-integrity": "warn",
    "sonarjs/content-security-policy": "warn",
    "sonarjs/no-mixed-content": "off",
    "sonarjs/frame-ancestors": "off",
    "sonarjs/no-mime-sniff": "warn",
    "sonarjs/no-referrer-policy": "warn",
    "sonarjs/strict-transport-security": "warn",
    "sonarjs/confidential-information-logging": "off",
    "sonarjs/no-ip-forward": "off",
    "sonarjs/empty-string-repetition": "warn",
    "sonarjs/regex-complexity": "warn",
    "sonarjs/no-incompatible-assertion-types": "warn",
    "sonarjs/anchor-precedence": "warn",
    "sonarjs/slow-regex": "warn",
    "sonarjs/no-invalid-regexp": "warn",
    "sonarjs/unused-named-groups": "warn",
    "sonarjs/no-same-argument-assert": "warn",
    "sonarjs/unicode-aware-regex": "off",
    "sonarjs/no-misleading-character-class": "warn",
    "sonarjs/duplicates-in-character-class": "warn",
    "sonarjs/session-regeneration": "warn",
    "sonarjs/prefer-specific-assertions": "warn",
    "sonarjs/no-trivial-assertions": "warn",
    "sonarjs/test-check-exception": "warn",
    "sonarjs/stable-tests": "warn",
    "sonarjs/parameterized-tests": "warn",
    "sonarjs/no-empty-after-reluctant": "warn",
    "sonarjs/single-character-alternation": "warn",
    "sonarjs/no-code-after-done": "warn",
    "sonarjs/disabled-timeout": "warn",
    "sonarjs/chai-determinate-assertion": "warn",
    "sonarjs/aws-s3-bucket-insecure-http": "warn",
    "sonarjs/aws-s3-bucket-versioning": "warn",
    "sonarjs/aws-s3-bucket-granted-access": "warn",
    "sonarjs/no-angular-bypass-sanitization": "warn",
    "sonarjs/aws-iam-public-access": "warn",
    "sonarjs/aws-ec2-unencrypted-ebs-volume": "warn",
    "sonarjs/aws-s3-bucket-public-access": "warn",
    "sonarjs/aws-iam-all-privileges": "warn",
    "sonarjs/aws-rds-unencrypted-databases": "warn",
    "sonarjs/aws-iam-all-resources-accessible": "off",
    "sonarjs/aws-opensearchservice-domain": "warn",
    "sonarjs/aws-iam-privilege-escalation": "warn",
    "sonarjs/aws-sagemaker-unencrypted-notebook": "warn",
    "sonarjs/aws-restricted-ip-admin-access": "warn",
    "sonarjs/no-empty-alternatives": "warn",
    "sonarjs/no-control-regex": "warn",
    "sonarjs/no-regex-spaces": "warn",
    "sonarjs/aws-sns-unencrypted-topics": "warn",
    "sonarjs/existing-groups": "warn",
    "sonarjs/aws-ec2-rds-dms-public": "warn",
    "sonarjs/aws-sqs-unencrypted-queue": "warn",
    "sonarjs/no-empty-group": "warn",
    "sonarjs/aws-efs-unencrypted": "warn",
    "sonarjs/aws-apigateway-public-api": "warn",
    "sonarjs/stateful-regex": "warn",
    "sonarjs/concise-regex": "warn",
    "sonarjs/single-char-in-character-classes": "warn",
    "sonarjs/no-hardcoded-secrets": "warn",
    "sonarjs/no-exclusive-tests": "warn",
    "sonarjs/hardcoded-secret-signatures": "warn",
    "sonarjs/jsx-no-leaked-render": "warn",
    "sonarjs/no-hook-setter-in-body": "warn",
    "sonarjs/no-useless-react-setstate": "warn",
    "sonarjs/no-uniq-key": "warn",
    "sonarjs/redundant-type-aliases": "warn",
    "sonarjs/prefer-regexp-exec": "warn",
    "sonarjs/no-internal-api-use": "warn",
    "sonarjs/prefer-read-only-props": "warn",
    "sonarjs/no-literal-call": "warn",
    "sonarjs/reduce-initial-value": "warn",
    "sonarjs/no-async-constructor": "warn",
    "sonarjs/review-blockchain-mnemonic": "warn",
    "sonarjs/dynamically-constructed-templates": "warn",
    "sonarjs/no-session-cookies-on-static-assets": "warn",
    "sonarjs/dompurify-unsafe-config": "warn",
    "sonarjs/no-duplicate-test-title": "warn",
    "sonarjs/async-test-assertions": "warn",
    "sonarjs/no-empty-test-title": "warn",
    "sonarjs/hooks-before-test-cases": "warn",
    "sonarjs/no-forced-browser-interaction": "warn",
    "sonarjs/assertions-in-test-cases": "warn",
    "sonarjs/synchronous-suite-callback": "warn",
    "sonarjs/super-linear-regex": "warn",
    "sonarjs/prefer-native-lodash-alternative": "warn",
    "sonarjs/no-default-utility-imports": "warn",
    "sonarjs/memoize-cache-key": "warn",
    "sonarjs/no-debug-commands-in-ui-tests": "warn",
    "sonarjs/no-mixed-completion-style": "warn",
    "sonarjs/no-interpolation-in-inline-snapshots": "warn",
    "sonarjs/explicit-test-skip": "warn",
    "perfectionist/sort-enums": "warn",
    "perfectionist/sort-exports": "warn",
    "perfectionist/sort-imports": "warn",
    "perfectionist/sort-interfaces": [
      "warn",
      {
        "groups": ["required-property", "optional-property"],
        "order": "asc"
      }
    ],
    "perfectionist/sort-intersection-types": "warn",
    "perfectionist/sort-named-imports": "warn",
    "perfectionist/sort-object-types": [
      "warn",
      {
        "groups": ["required-property", "optional-property"],
        "order": "asc"
      }
    ],
    "perfectionist/sort-union-types": [
      "warn",
      {
        "groups": [
          "conditional",
          "function",
          "import",
          "intersection",
          "named",
          "object",
          "operator",
          "literal",
          "keyword",
          "tuple",
          "union",
          "nullish"
        ],
        "order": "asc",
        "type": "alphabetical"
      }
    ],
    "no-underscore-dangle": "off",
    "unicorn/no-empty-file": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/consistent-type-imports": [
      "warn",
      {
        "fixStyle": "separate-type-imports",
        "prefer": "type-imports"
      }
    ],
    "turbo/no-undeclared-env-vars": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.ts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/no-importing-vitest-globals": "off",
        "vitest/no-standalone-expect": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx,cts,mts,js,jsx,cjs,mjs}"],
      "rules": {
        "sonarjs/no-hardcoded-passwords": "off"
      }
    },
    {
      "files": ["**/*.service.ts", "**/*.repository.ts"],
      "rules": {
        "perfectionist/sort-interfaces": [
          "warn",
          {
            "useConfigurationIf": {
              "declarationMatchesPattern": "^[A-Za-z0-9_]+(?:Service|Repository)Shape$"
            },
            "groups": [
              "operation-create",
              "operation-get-all",
              "operation-get-by-id",
              "operation-update",
              "operation-delete",
              "unknown"
            ],
            "customGroups": [
              {
                "groupName": "operation-create",
                "elementNamePattern": "^create$"
              },
              {
                "groupName": "operation-get-all",
                "elementNamePattern": "^getAll$"
              },
              {
                "groupName": "operation-get-by-id",
                "elementNamePattern": "^getById$"
              },
              {
                "groupName": "operation-update",
                "elementNamePattern": "^update$"
              },
              {
                "groupName": "operation-delete",
                "elementNamePattern": "^delete(?:ById)?$"
              }
            ]
          },
          {
            "groups": ["required-property", "optional-property"],
            "order": "asc"
          }
        ]
      }
    }
  ]
}
