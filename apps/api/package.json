    "@effect/vitest": "4.0.0-beta.106",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsx": "^4.23.11",
    "typescript": "5.9.2",
    "vitest": "^4.1.0"
  }
