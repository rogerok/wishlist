{
  "name": "@wishlist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:down": "docker compose --env-file .env.development -f docker-compose.dev.yml down",
    "db:generate": "kysely-codegen",
    "db:logs": "docker compose --env-file .env.development -f docker-compose.dev.yml logs -f postgres",
    "db:migrate": "tsx --conditions=development --env-file=.env.development src/bin/migrate.ts",
    "db:ready": "docker compose --env-file .env.development -f docker-compose.dev.yml exec postgres pg_isready -U postgres -d wishlist",
    "db:up": "docker compose --env-file .env.development -f docker-compose.dev.yml up -d --wait postgres",
    "db:check": "kysely-codegen --verify",
    "dev": "tsx watch --conditions=development --env-file=.env.development src/main.ts",
    "lint": "eslint",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/sql-pg": "4.0.0-rc.108",
    "@repo/sql-kysely": "workspace:^",
    "effect": "4.0.0-rc.108",
    "kysely": "0.29.5",
    "pg": "^8.23.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.4",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.21.0",
    "eslint": "^9.39.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
