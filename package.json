{
  "name": "wishlist",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:check": "pnpm --filter @wishlist/api db:check",
    "db:down": "pnpm --filter @wishlist/api db:down",
    "db:generate": "pnpm --filter @wishlist/api db:generate",
    "db:logs": "pnpm --filter @wishlist/api db:logs",
    "db:migrate": "pnpm --filter @wishlist/api db:migrate",
    "db:ready": "pnpm --filter @wishlist/api db:ready",
    "db:up": "pnpm --filter @wishlist/api db:up",
    "repl": "pnpm --filter @wishlist/api repl",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-turbo": "2.11.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.88.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=26"
  }
}
